# Exercise 16: Flatten Nested List
# Write a function to flatten a list of lists into a single, non-nested list. (e.g., [[1, 2], [3, 4]] becomes [1, 2, 3, 4]).

# Given:

# list_of_lists = [[1, 2], [3, 4], [5, 6, 7]]
# Expected Output:

# [1, 2, 3, 4, 5, 6, 7]
list_of_lists = [[1, 2], [3, 4], [5, 6, 7]]
listss = []

for sub in list_of_lists:
    for num in sub:
        listss.append(num)

print(listss)
 
# Exercise 17: Concatenate two lists index-wise
# Write a program to add two lists index-wise. Create a new list that contains the 0th index item from both the list, then the 1st index item, and so on till the last element. any leftover items will get added at the end of the new list.

# Given:

# list1 = ["M", "na", "i", "Ke"]
# list2 = ["y", "me", "s", "lly"]
# Expected output:

# ['My', 'name', 'is', 'Kelly']
list1 = ["M", "na", "i", "Ke"]
list2 = ["y", "me", "s", "lly"]
list3 = map(lambda list1,list2 :list1+list2,list1,list2)
print(list(list3))
list4 = [i+j for i,j in zip(list1,list2)]
print(list(list4))

