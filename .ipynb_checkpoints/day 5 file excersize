# Exercise 9: Copy a File
# Write a program that takes two filenames as input (source and destination) and copies the content of the source file to the destination file.
def copying_file(source,destination):
    try:
        with open(source,'r') as rf:
            content = rf.read()
        with open(destination,'w') as wf:
            wf.write(content)
        print(f"Successfully copied {source} to {destination}")
    except Exception as e:
        print("Error")

source_loc = 'D:\Python for data science\.ipynb_checkpoints\sample.txt'
des_loc = 'Destination.txt'
copying_file(source_loc,des_loc)

