c.sound()
# 13. Multiple methods
# Class Calculator
# Methods: add, subtract, multiply
class Calculator():
    def __init__(self,a,b):
        self.a = a
        self.b = b
    def add(self):
        return self.a + self.b
    def sub(self):
        return self.a - self.b
    def mul(self):
        return self.a * self.b
c = Calculator(5,5)
print(c.add())
print(c.sub())
print(c.mul())
