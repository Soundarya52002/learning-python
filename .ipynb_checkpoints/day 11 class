# 11. Inheritance (basic)
# Class Animal
# Method eat()
# Child class Dog
class Animal():
    def eating(self):
        print("Animal is eating")
class Dog(Animal):
    def dogeat(self):
        print("Dog is eating")
d = Dog()
d.eating()
d.dogeat()
# 12. Method overriding
# Parent: Animal → method sound()
# Child: Cat → override it
class Animal():
    def sound(self):
        print("inside the animal class")
class Cat(Animal):
    def sound(self):
        print("inside the cat class")
c = Cat()
c.sound()
# 13. Multiple methods
# Class Calculator
# Methods: add, subtract, multiply
class Calculator():
    def __init__(self,a,b):
        self.a = a
        self.b = b
    def add(self):
        return self.a + self.b
    def sub(self):
        return self.a - self.b
    def mul(self):
        return self.a * self.b
c = Calculator(5,5)
print(c.add())
print(c.sub())
print(c.mul())
# 14. Encapsulation (private variable)
# Class Account
# Make balance private
# Use getter method
class Account():
    def __init__(self,bal):
        self.__bal = bal
    def get_bal(self):
        return self.__bal 
a = Account(50)
print(a.get_bal())
