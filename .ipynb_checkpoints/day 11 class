# 16. Student grade system
# Store marks
# Method to return grade (A/B/C)
class Student:
    def __init__(self,name,marks):
        self.name= name
        self.marks = marks
    def grades(self):
        if self.marks >= 90:
            return 'A'
        elif self.marks >=80 and self.marks < 90:
            return 'B'
        else:
            return 'c'
s1 = Student('Soundarya',100)
print(s1.grades())
