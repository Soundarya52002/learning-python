# Exercise 6: Count Specific Word From a File
# Write a program to count the occurrences of a specific word (e.g., “hello”) in a given file.

def count_specific_word(filename,word):
    try:
        with open(filename,'r') as rf:
            content = rf.read().lower()
            words = content.split()
            count = 0
            for w in words:
                cleaned_words = w.strip('./,1:;!@#$%^')
                if cleaned_words == word:
                    count +=1
            return count
    except FileNotFoundError:
        print("File not found")
        return 0
    
filename_to_search = 'D:\Python for data science\.ipynb_checkpoints\sample.txt'
word_count = 'The'
result = count_specific_word(filename_to_search,word_count)
print(result)