# Exercise 4: Count Words From a File
# Create a function that takes a filename as input and returns the total number of words in that file.
import re

def count_words_from_a_file(filename):
    try:
        with open(filename,'r') as rf:
            content = rf.read().lower()
            words = re.findall(r'\b\w+\b', content)
            return len(words)
    except FileNotFoundError:
        print("File not found")
        return 0

words_count = count_words_from_a_file('D:\Python for data science\.ipynb_checkpoints\sample.txt')
print(words_count)

