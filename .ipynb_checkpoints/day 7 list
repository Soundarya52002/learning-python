# Exercise 16: Flatten Nested List
# Write a function to flatten a list of lists into a single, non-nested list. (e.g., [[1, 2], [3, 4]] becomes [1, 2, 3, 4]).

# Given:

# list_of_lists = [[1, 2], [3, 4], [5, 6, 7]]
# Expected Output:

# [1, 2, 3, 4, 5, 6, 7]

list_of_lists = [[1, 2], [3, 4], [5, 6, 7]]

def flat(listing):
    new = []
    for i in listing:
        for j in i:
            new.append(j)
    return new

a = flat(list_of_lists)
print(a)

#alternating

def flatting(listing):
    return[j for i in listing for j in i]
b = flatting(list_of_lists)
print("This is with the list comprehension: ",b)

